# AI & API Configuration
GEMINI_API_KEY=your_gemini_api_key

# Meta / WhatsApp webhook verification (Meta Developer Console → Webhook → Verify token)
# NO es la contraseña de Instagram — es una palabra que TÚ inventas y repites en Meta al registrar el webhook.
kamban_VERIFY_TOKEN=vg37e

# Meta (Facebook) App — developers.facebook.com → Tu app → Configuración → Básica
NEXT_PUBLIC_META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key




# Firebase Admin (servidor). Una de: FIREBASE_SERVICE_ACCOUNT_BASE64, o el par de abajo, o FIREBASE_SERVICE_ACCOUNT (JSON)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seguridad de rutas API (src/lib/apiAuth.ts)
# 'enforce' = rechaza peticiones sin sesión válida o a nombre de otro usuario (RECOMENDADO en producción)
# 'log' = solo registra "[api-auth] violation" y deja pasar (modo de transición) · 'off' = desactivado
API_AUTH_MODE=enforce

# Migración global del molde de entidades (POST /api/admin/migrate-mold, header x-migration-secret)
MOLD_MIGRATION_SECRET=

# GitHub OAuth (web-builder)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=
